d"},{"name":"Accept-Language","value":"es-419,es;q=0.8"},{"name":"Cache-Control","value":"no-cache"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"s3.us-east-2.amazonaws.com"},{"name":"Origin","value":"https://apps.magiis.com"},{"name":"Pragma","value":"no-cache"},{"name":"Referer","value":"https://apps.magiis.com/"},{"name":"Sec-Fetch-Dest","value":"empty"},{"name":"Sec-Fetch-Mode","value":"cors"},{"name":"Sec-Fetch-Site","value":"cross-site"},{"name":"Sec-GPC","value":"1"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36"},{"name":"sec-ch-ua","value":"\"Chromium\";v=\"148\", \"Brave\";v=\"148\", \"Not/A)Brand\";v=\"99\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""}],"queryString":[],"cookies":[],"headersSize":661,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","headers":[{"name":"Accept-Ranges","value":"bytes"},{"name":"Access-Control-Allow-Methods","value":"GET"},{"name":"Access-Control-Allow-Origin","value":"*"},{"name":"Content-Length","value":"1698"},{"name":"Content-Type","value":"application/json"},{"name":"Date","value":"Fri, 11 Sep 2026 14:12:47 GMT"},{"name":"ETag","value":"\"3b37e1f56aa7520f0155cec2c0fcc3f1\""},{"name":"Last-Modified","value":"Mon, 08 Feb 2021 19:04:29 GMT"},{"name":"Server","value":"AmazonS3"},{"name":"Vary","value":"Origin, Access-Control-Request-Headers, Access-Control-Request-Method"},{"name":"x-amz-id-2","value":"Dri2CZrX3Qkwtx9DFI11vqH5ntRYKtO0LUaL68MdFosoUAiMU0jVXTzEVjFfoHSPFiMfcHOhK8tOXd5KSxDYr1DxkgefnY8/"},{"name":"x-amz-request-id","value":"DZ6MZ40EA0PR81XH"},{"name":"x-amz-version-id","value":"null"}],"cookies":[],"content":{"size":1698,"mimeType":"application/json","compression":0,"text":"[{\"version\":\"1.4.0 \\u221a\",\"information\":{\"es\":\"1- Agrega bot\\u00f3n de Otros Costos al cierre de viaje.\\n2- Agrega selecci\\u00f3n de Asistente de navegaci\\u00f3n en preferencias App driver. \\n3- Agrega funci\\u00f3n filtro por carreteo, permite excluir de la b\\u00fasqueda chofer distantes para viajes cortos. \\n4- Agrega mejoras en algoritmo de b\\u00fasqueda. \\n5- Cambia el uso de los Destinos Frecuentes (FD), estos ahora son parte de cada Tarifador. \",\"en\":\" \"}},{\"version\":\"1.3.0 \\u221a\",\"information\":{\"es\":\"1- Agrega cierre administrativo de un viaje en Curso o Cancelado.\\n2- Permite desactivar control de Geo Cerca para comienzo de viaje.\\n3- Descarga de contactos a archivos CSV.\",\"en\":\" \"}},{\"version\":\"1.2.0 \\u221a\",\"information\":{\"es\":\"1- Agrega Mapa de calor y nuevos indicadores al tablero Gerencial.\\n2- Nuevo reporte de viajes por segmentos.\",\"en\":\" \"}},{\"version\":\"1.1.0 \\u221a\",\"information\":{\"es\":\"1- Agrega la posibilidad de cancelar saldos de Ctas. Ctes. con Tarjeta de cr\\u00e9dito.\\n2- Nuevos Reportes:\\n  a. Ranking de Veh\\u00edculos.\\n  b. Ranking de Choferes.\\n  c. Ranking de Clientes.\",\"en\":\" \"}},{\"version\":\"1.0.0 \\u221a\",\"information\":{\"es\":\"1- Nuevos filtros de Fechas que permite al usuario configurar rangos en los paneles.\\n2- Nueva Sala de CHAT que facilita la comunicaci\\u00f3n del chofer con el pasajero.\\n3- Agrega los viajes programados a la asignaci\\u00f3n autom\\u00e1tica de choferes.\\n4- Nuevo Marketplace de Integraciones soportadas.\\n5- Nueva versi\\u00f3n de APP Passenger:\\n  a. Agrega un nuevo aspecto m\\u00e1s amigable.\\n  b. Seguimiento de viaje en curso en el mapa\",\"en\":\" \"}}]"},"redirectURL":"","headersSize":552,"bodySize":1698,"_transferSize":2250,"_error":null,"_fetchedViaServiceWorker":false},"serverIPAddress":"3.5.131.211","startedDateTime":"2026-09-11T14:12:44.648Z","time":210.51799999986542,"timings":{"blocked":4.8619999998454,"dns":-1,"ssl":-1,"connect":-1,"send":0.10399999999999998,"wait":204.32900000072038,"receive":1.2229999992996454,"_blocked_queueing":4.3839999998454005,"_workerSta