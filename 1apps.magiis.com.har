rol-Allow-Methods","value":"GET"},{"name":"Access-Control-Allow-Origin","value":"*"},{"name":"Content-Length","value":"1698"},{"name":"Content-Type","value":"application/json"},{"name":"Date","value":"Fri, 11 Sep 2026 14:12:50 GMT"},{"name":"ETag","value":"\"3b37e1f56aa7520f0155cec2c0fcc3f1\""},{"name":"Last-Modified","value":"Mon, 08 Feb 2021 19:04:29 GMT"},{"name":"Server","value":"AmazonS3"},{"name":"Vary","value":"Origin, Access-Control-Request-Headers, Access-Control-Request-Method"},{"name":"x-amz-id-2","value":"y8TDbM9rDmDq0o04cV9nrgzdsWAR7zu4tyrT+HP6GwAKHGWv64vln20LUeU2lrSXbPldoKHQEkylvS9lPqiPEU/AOONV2lFT"},{"name":"x-amz-request-id","value":"M092R8035AC2WJB3"},{"name":"x-amz-version-id","value":"null"}],"cookies":[],"content":{"size":1698,"mimeType":"application/json","compression":0,"text":"[{\"version\":\"1.4.0 \\u221a\",\"information\":{\"es\":\"1- Agrega bot\\u00f3n de Otros Costos al cierre de viaje.\\n2- Agrega selecci\\u00f3n de Asistente de navegaci\\u00f3n en preferencias App driver. \\n3- Agrega funci\\u00f3n filtro por carreteo, permite excluir de la b\\u00fasqueda chofer distantes para viajes cortos. \\n4- Agrega mejoras en algoritmo de b\\u00fasqueda. \\n5- Cambia el uso de los Destinos Frecuentes (FD), estos ahora son parte de cada Tarifador. \",\"en\":\" \"}},{\"version\":\"1.3.0 \\u221a\",\"information\":{\"es\":\"1- Agrega cierre administrativo de un viaje en Curso o Cancelado.\\n2- Permite desactivar control de Geo Cerca para comienzo de viaje.\\n3- Descarga de contactos a archivos CSV.\",\"en\":\" \"}},{\"version\":\"1.2.0 \\u221a\",\"information\":{\"es\":\"1- Agrega Mapa de calor y nuevos indicadores al tablero Gerencial.\\n2- Nuevo reporte de viajes por segmentos.\",\"en\":\" \"}},{\"version\":\"1.1.0 \\u221a\",\"information\":{\"es\":\"1- Agrega la posibilidad de cancelar saldos de Ctas. Ctes. con Tarjeta de cr\\u00e9dito.\\n2- Nuevos Reportes:\\n  a. Ranking de Veh\\u00edculos.\\n  b. Ranking de Choferes.\\n  c. Ranking de Clientes.\",\"en\":\" \"}},{\"version\":\"1.0.0 \\u221a\",\"information\":{\"es\":\"1- Nuevos filtros de Fechas que permite al usuario configurar rangos en los paneles.\\n2- Nueva Sala de CHAT que facilita la comunicaci\\u00f3n del chofer con el pasajero.\\n3- Agrega los viajes programados a la asignaci\\u00f3n autom\\u00e1tica de choferes.\\n4- Nuevo Marketplace de Integraciones soportadas.\\n5- Nueva versi\\u00f3n de APP Passenger:\\n  a. Agrega un nuevo aspecto m\\u00e1s amigable.\\n  b. Seguimiento de viaje en curso en el mapa\",\"en\":\" \"}}]"},"redirectURL":"","headersSize":552,"bodySize":1698,"_transferSize":2250,"_error":null,"_fetchedViaServiceWorker":false},"serverIPAddress":"3.5.131.211","startedDateTime":"2026-09-11T14:12:48.124Z","time":230.50599999987753,"timings":{"blocked":3.2959999982351436,"dns":-1,"ssl":-1,"connect":-1,"send":0.10099999999999998,"wait":222.09499999952223,"receive":5.014000002120156,"_blocked_queueing":2.2299999982351437,"_workerStart":-1,"_workerReady":-1,"_workerFetchStart":-1,"_workerRespondWithSettled":-1},"_connectionId":"281862"},{"_initiator":{"type":"script","stack":{"callFrames":[{"functionName":"d","scriptId":"437","url":"https://apps.magiis.com/polyfills.57f0282707e064b756be.bundle.js","lineNumber":0,"columnNumber":76229},{"functionName":"","scriptId":"437","url":"https://apps.magiis.com/polyfills.57f0282707e064b756be.bundle.js","lineNumber":0,"columnNumber":45453},{"functionName":"onScheduleTask","scriptId":"437","url":"https://apps.magiis.com/polyfills.57f0282707e064b756be.bundle.js","lineNumber":0,"columnNumber":42622},{"functionName":"","scriptId":"437","url":"https://apps.magiis.com/polyfills.57f0282707e064b756be.bundle.js","lineNumber":0,"columnNumber":45352},{"functionName":"","scriptId":"437","url":"https://apps.magiis.com/polyfills.57f0282707e064b756be.bundle.js","lineNumber":0,"columnNumber":41457},{"functionName":"","scriptId":"437","url":"https://apps.magiis.com/polyfills.57f0282707e064b756be.bundle.js","lineNumber":0