,"headersSize":661,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","headers":[{"name":"Accept-Ranges","value":"bytes"},{"name":"Access-Control-Allow-Methods","value":"GET"},{"name":"Access-Control-Allow-Origin","value":"*"},{"name":"Content-Length","value":"1698"},{"name":"Content-Type","value":"application/json"},{"name":"Date","value":"Fri, 11 Sep 2026 14:13:13 GMT"},{"name":"ETag","value":"\"3b37e1f56aa7520f0155cec2c0fcc3f1\""},{"name":"Last-Modified","value":"Mon, 08 Feb 2021 19:04:29 GMT"},{"name":"Server","value":"AmazonS3"},{"name":"Vary","value":"Origin, Access-Control-Request-Headers, Access-Control-Request-Method"},{"name":"x-amz-id-2","value":"si47HcgFGqtLFHOySm3c13OZPW0Z9R1HE7e0oztuw2QRV9pUtDVQK7tSlbpO3miDOrf9FbyTtv1/wRl/OtNpY+2DA7sA9ikq"},{"name":"x-amz-request-id","value":"NYHGV8T4GE97EZVF"},{"name":"x-amz-version-id","value":"null"}],"cookies":[],"content":{"size":1698,"mimeType":"application/json","compression":0,"text":"[{\"version\":\"1.4.0 \\u221a\",\"information\":{\"es\":\"1- Agrega bot\\u00f3n de Otros Costos al cierre de viaje.\\n2- Agrega selecci\\u00f3n de Asistente de navegaci\\u00f3n en preferencias App driver. \\n3- Agrega funci\\u00f3n filtro por carreteo, permite excluir de la b\\u00fasqueda chofer distantes para viajes cortos. \\n4- Agrega mejoras en algoritmo de b\\u00fasqueda. \\n5- Cambia el uso de los Destinos Frecuentes (FD), estos ahora son parte de cada Tarifador. \",\"en\":\" \"}},{\"version\":\"1.3.0 \\u221a\",\"information\":{\"es\":\"1- Agrega cierre administrativo de un viaje en Curso o Cancelado.\\n2- Permite desactivar control de Geo Cerca para comienzo de viaje.\\n3- Descarga de contactos a archivos CSV.\",\"en\":\" \"}},{\"version\":\"1.2.0 \\u221a\",\"information\":{\"es\":\"1- Agrega Mapa de calor y nuevos indicadores al tablero Gerencial.\\n2- Nuevo reporte de viajes por segmentos.\",\"en\":\" \"}},{\"version\":\"1.1.0 \\u221a\",\"information\":{\"es\":\"1- Agrega la posibilidad de cancelar saldos de Ctas. Ctes. con Tarjeta de cr\\u00e9dito.\\n2- Nuevos Reportes:\\n  a. Ranking de Veh\\u00edculos.\\n  b. Ranking de Choferes.\\n  c. Ranking de Clientes.\",\"en\":\" \"}},{\"version\":\"1.0.0 \\u221a\",\"information\":{\"es\":\"1- Nuevos filtros de Fechas que permite al usuario configurar rangos en los paneles.\\n2- Nueva Sala de CHAT que facilita la comunicaci\\u00f3n del chofer con el pasajero.\\n3- Agrega los viajes programados a la asignaci\\u00f3n autom\\u00e1tica de choferes.\\n4- Nuevo Marketplace de Integraciones soportadas.\\n5- Nueva versi\\u00f3n de APP Passenger:\\n  a. Agrega un nuevo aspecto m\\u00e1s amigable.\\n  b. Seguimiento de viaje en curso en el mapa\",\"en\":\" \"}}]"},"redirectURL":"","headersSize":552,"bodySize":1698,"_transferSize":2250,"_error":null,"_fetchedViaServiceWorker":false},"serverIPAddress":"3.5.131.211","startedDateTime":"2026-09-11T14:13:11.155Z","time":205.62699999572942,"timings":{"blocked":4.407999995719176,"dns":-1,"ssl":-1,"connect":-1,"send":0.77,"wait":198.7909999989667,"receive":1.658000001043547,"_blocked_queueing":2.415999995719176,"_workerStart":-1,"_workerReady":-1,"_workerFetchStart":-1,"_workerRespondWithSettled":-1},"_connectionId":"281862"},{"_initiator":{"type":"preflight","url":"https://api.apps.magiis.com/usertrail/register","requestId":"46975.1636"},"_priority":"High","_resourceType":"preflight","cache":{},"connection":"443","request":{"method":"OPTIONS","url":"https://api.apps.magiis.com/usertrail/register","httpVersion":"http/2.0","headers":[{"name":":authority","value":"[REDACTED]"},{"name":":method","value":"OPTIONS"},{"name":":path","value":"/usertrail/register"},{"name":":scheme","value":"https"},{"name":"accept","value":"*/*"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"accept-language","value":"es-419,es;q=0.9"},{"name":"access-control-request-headers","value":"authorization,content-type"},{"name":"access-control-request-method","value":"POST"},{"name":"ca